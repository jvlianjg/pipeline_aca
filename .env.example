# ─────────────────────────────────────────────────────────────
#  ACA - Medición del Impacto de Ideas en Políticas Públicas
#  Copia este archivo como `.env` y completa los valores.
# ─────────────────────────────────────────────────────────────

# Proveedor de IA para la capa comercial (opcional).
# Por defecto el sistema funciona 100% en local con sentence-transformers.
# Valores posibles: "local" (default) | "anthropic" | "gemini" | "openai"
LLM_PROVIDER=local

# API key de Anthropic (solo si LLM_PROVIDER=anthropic), de console.anthropic.com
# con créditos comprados (mínimo $5). La corrida completa del corpus
# (~651 fragmentos) cuesta ≈$4.13 una sola vez con claude-haiku-4-5;
# re-ejecutar no vuelve a pagar gracias a la caché.
# ANTHROPIC_API_KEY=

# API key de OpenAI (solo si LLM_PROVIDER=openai).
# Con la key activa, el extractor de propuestas usa LLM (con caché en
# data/interim/llm_props/ y fallback a la heurística por documento).
# OPENAI_API_KEY=

# API key de Google AI Studio (solo si LLM_PROVIDER=gemini), con facturación
# activada (crédito mínimo $10). La corrida completa cuesta ≈$1.18 una sola
# vez con gemini-3.1-flash-lite; la caché evita re-pagar en re-ejecuciones.
# GEMINI_API_KEY=

# Límite opcional de peticiones por minuto hacia Gemini (0 = sin límite;
# útil solo si usas el nivel gratuito en vez del pagado).
# GEMINI_RPM=0

# Modelo de embeddings comercial (solo si LLM_PROVIDER=openai).
# EMBEDDING_MODEL=text-embedding-3-small

# Modelo del extractor de propuestas (según proveedor). Si no se define,
# cada proveedor usa su default: anthropic ⇒ claude-haiku-4-5,
# gemini ⇒ gemini-3.1-flash-lite, openai ⇒ gpt-4o-mini.
# PROPOSAL_MODEL=claude-haiku-4-5

# Modelo de embeddings local (sentence-transformers).
# Alternativas: "intfloat/multilingual-e5-small"
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
